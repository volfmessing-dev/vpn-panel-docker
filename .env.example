# Run python3 scripts/setup.py to generate .env and panel authentication.
POSTGRES_DB=bypass_manager
POSTGRES_USER=bypass_manager
POSTGRES_PASSWORD=
PANEL_BIND_IP=127.0.0.1
PANEL_HTTP_PORT=8080
PANEL_DOMAIN=
ACME_EMAIL=
BACKEND_CORS_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=
SSH_KEY_PATH=/run/secrets/ssh/id_ed25519
BYPASS_DOMAINS_PATH=/data/bypass-domains.txt
# Optional comma-separated CIDRs, empty by default. Never use 0.0.0.0/0 here.
BYPASS_CIDRS=
